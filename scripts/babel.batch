#!/bin/bash
# Customize SBATCH directives for your cluster
#SBATCH -p general
#SBATCH -J main
#SBATCH -N 1
#SBATCH --gres=gpu:1
#SBATCH -c 14
#SBATCH --mem=40G
#SBATCH -t 20:00:00
#SBATCH -o exp/slurm_logs/%A_%a.out
#SBATCH -e exp/slurm_logs/%A_%a.out

# === Directory Setup ===
cd "${SLURM_SUBMIT_DIR:-.}"
mkdir -p "exp/slurm_logs"
# === Environment setup ===
source .venv/bin/activate
export HYDRA_FULL_ERROR=1
export PHONEMIZER_ESPEAK_LIBRARY="${PHONEMIZER_ESPEAK_LIBRARY:?Set PHONEMIZER_ESPEAK_LIBRARY}"
export ESPEAK_DATA_PATH="${ESPEAK_DATA_PATH:?Set ESPEAK_DATA_PATH}"
###########################
echo "RUNNING ON NODE: $(hostname)"
echo "START TIME: $(date)"
echo "SLURM_JOB_ID: $SLURM_JOB_ID"
nvidia-smi
export NCCL_P2P_DISABLE=1
echo "RunningCMD: python src/main.py $*"
###########################
python src/main.py "$@"
